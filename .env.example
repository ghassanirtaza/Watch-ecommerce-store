# Database — use a POOLED connection string in production (PgBouncer /
# Prisma Accelerate). directUrl is used only for migrations.
DATABASE_URL="postgresql://user:password@host:5432/watch_ecommerce?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/watch_ecommerce"

# Auth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Payment gateway — provider TBD, see docs/AI_CONTEXT.md open decisions
PAYMENT_PROVIDER=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend
RESEND_API_KEY=""

# Upstash Redis (rate limiting only — never treat as primary database)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# WhatsApp Business API — external approval lead time, see AI_CONTEXT.md
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_DEFAULT_COUNTRY="PK"

# Cron (protects /api/cron/sweep from public invocation)
CRON_SECRET=""
