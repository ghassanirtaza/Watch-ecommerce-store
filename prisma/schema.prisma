// ============================================================
// WATCH E-COMMERCE PLATFORM — PRISMA SCHEMA
// Pakistan-only launch. Modular monolith. PostgreSQL.
// See /docs/AI_CONTEXT.md for architectural principles.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Use a pooled connection string (PgBouncer / Prisma Accelerate) in
  // serverless deployment. Direct connections will exhaust the Postgres
  // connection limit under real traffic — see docs/AI_CONTEXT.md.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ------------------------------------------------------------
// AUTH / RBAC
// ------------------------------------------------------------

enum RoleName {
  CUSTOMER
  SUPPORT_AGENT
  CONTENT_MANAGER
  ORDER_MANAGER
  STORE_MANAGER
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String? // required by Better Auth's default schema
  email         String    @unique
  phone         String?   @unique
  emailVerified Boolean   @default(false)
  image         String? // Better Auth default field, unused for admins
  isActive      Boolean   @default(true)
  isAdminUser   Boolean   @default(false) // true for any staff/admin login,
                                            // false for storefront customers —
                                            // keeps admin/storefront auth
                                            // logically separate even though
                                            // they share the User table
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles           UserRole[]
  sessions        Session[]
  accounts        Account[]
  customerProfile CustomerProfile?
  auditLogs       AuditLog[]         @relation("AuditActor")

  @@index([email])
}

// Better Auth: stores credential (hashed password) and OAuth provider
// links separately from User. One user can have multiple accounts
// (e.g. email/password + Google) if social login is added later.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String // "credential", "google", etc.
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hashed, only set for providerId="credential"
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([providerId, accountId])
  @@index([userId])
}

// Better Auth: email verification / password reset tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String // usually the email
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // e.g. "products.update"
  domain String // e.g. "products"

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ------------------------------------------------------------
// CUSTOMER
// ------------------------------------------------------------

model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  firstName      String?
  lastName       String?
  marketingOptIn Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id])
  addresses Address[]
  carts     Cart[]
  orders    Order[]
  wishlist  Wishlist?
  reviews   Review[]
  returnRequests ReturnRequest[]
  codRiskFlag CustomerCodRiskFlag?
}

model Address {
  id             String  @id @default(cuid())
  customerId     String
  label          String? // e.g. "Home", "Office"
  fullName       String
  phone          String
  addressLine1   String
  addressLine2   String?
  city           String // Pakistan city, controlled list at app layer
  postalCode     String? // optional — low reliability in Pakistan
  country        String  @default("PK")
  isDefault      Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId])
}

// COD fraud/risk tracking — flagged as a gap in review: not just a boolean,
// tracks history so admin can see delivery-success pattern.
model CustomerCodRiskFlag {
  id                    String   @id @default(cuid())
  customerId            String   @unique
  failedDeliveryCount   Int      @default(0)
  totalCodOrders        Int      @default(0)
  isBlocked             Boolean  @default(false)
  blockedReason         String?
  updatedAt             DateTime @updatedAt

  customer CustomerProfile @relation(fields: [customerId], references: [id])
}

// ------------------------------------------------------------
// CATALOG
// ------------------------------------------------------------

enum ProductStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  brand            String?
  shortDescription String?
  longDescription  String?
  status           ProductStatus @default(DRAFT)

  // Watch-domain fields (flagged as missing in review — generic e-commerce
  // spec had no category-specific attributes for a watch platform)
  movementType     String? // e.g. "Automatic", "Quartz", "Mechanical"
  caseMaterial     String?
  caseDiameterMm   Float?
  waterResistanceM Int?
  warrantyMonths   Int?
  hasAuthCertificate Boolean     @default(false)
  boxAndPapers     Boolean       @default(false)

  seoTitle         String?
  seoDescription   String?
  canonicalPath    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  variants      ProductVariant[]
  categories    ProductCategory[]
  attributes    ProductAttribute[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  redirects     Redirect[]

  @@index([status])
  @@index([slug])
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  sku             String  @unique
  variantName     String // e.g. "42mm / Silver / Leather Strap"
  price           Decimal @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  barcode         String?
  isActive        Boolean @default(true)

  // Watch-domain: serial-level tracking is a business decision, not
  // decided yet — see docs/AI_CONTEXT.md open decisions. Aggregate
  // quantity inventory is the default; SerializedUnit is optional/unused
  // until that decision is made.

  product        Product              @relation(fields: [productId], references: [id])
  attributeValues ProductAttributeValue[]
  inventory      Inventory[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  serializedUnits SerializedUnit[]

  @@index([productId])
}

// Optional serial-level tracking for high-value watches. Populate only if
// the business decides a SKU needs per-unit serial tracking (see review
// notes: anti-swap-fraud on returns, warranty registration, insurance).
model SerializedUnit {
  id           String   @id @default(cuid())
  variantId    String
  serialNumber String   @unique
  status       String   @default("IN_STOCK") // IN_STOCK, RESERVED, SOLD, RETURNED, DAMAGED
  orderItemId  String?
  createdAt    DateTime @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id])
}

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?
  imageUrl String?
  seoTitle String?
  seoDescription String?
  sortOrder Int    @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
}

model ProductAttribute {
  id       String @id @default(cuid())
  productId String
  key      String // e.g. "strap_material"
  value    String

  product Product @relation(fields: [productId], references: [id])
  values  ProductAttributeValue[]

  @@unique([productId, key])
}

model ProductAttributeValue {
  id          String @id @default(cuid())
  variantId   String
  attributeId String

  variant   ProductVariant   @relation(fields: [variantId], references: [id])
  attribute ProductAttribute @relation(fields: [attributeId], references: [id])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  mediaAssetId String
  sortOrder Int     @default(0)

  product     Product     @relation(fields: [productId], references: [id])
  mediaAsset  MediaAsset  @relation(fields: [mediaAssetId], references: [id])
}

model MediaAsset {
  id          String   @id @default(cuid())
  publicId    String   @unique // Cloudinary public ID
  url         String
  width       Int?
  height      Int?
  format      String?
  sizeBytes   Int?
  altText     String?
  createdById String?
  createdAt   DateTime @default(now())

  productImages ProductImage[]
  banners       Banner[]
  reviewImages  ReviewImage[]
}

// ------------------------------------------------------------
// INVENTORY
// ------------------------------------------------------------

model InventoryLocation {
  id        String  @id @default(cuid())
  name      String
  isPrimary Boolean @default(true) // single location at launch; model
                                     // supports more without migration

  inventory Inventory[]
}

model Inventory {
  variantId          String
  locationId         String
  availableQuantity  Int      @default(0)
  reservedQuantity   Int      @default(0)
  lowStockThreshold  Int      @default(5)
  updatedAt          DateTime @updatedAt

  variant  ProductVariant    @relation(fields: [variantId], references: [id])
  location InventoryLocation @relation(fields: [locationId], references: [id])

  @@id([variantId, locationId])
}

enum InventoryTransactionType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
  DAMAGED
  RESERVATION_HOLD
  RESERVATION_RELEASE
}

model InventoryTransaction {
  id           String                    @id @default(cuid())
  variantId    String
  locationId   String
  type         InventoryTransactionType
  quantityChange Int
  reason       String?
  reference    String? // e.g. order ID
  actorId      String? // admin user, null if system-generated
  createdAt    DateTime                  @default(now())

  @@index([variantId])
}

// Reservation is DB-backed, not Redis-backed — correctness must not
// depend on an external cache. TTL is enforced via lazy-expiry (checked
// on every read) plus a periodic cleanup job — see docs/AI_CONTEXT.md,
// "reservation-expiry mechanism" open item from architecture review.
model InventoryReservation {
  id         String   @id @default(cuid())
  variantId  String
  cartId     String?
  orderId    String?
  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([variantId])
  @@index([expiresAt])
}

// ------------------------------------------------------------
// CART
// ------------------------------------------------------------

model Cart {
  id         String   @id @default(cuid())
  customerId String? // null for guest cart
  guestToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer CustomerProfile? @relation(fields: [customerId], references: [id])
  items    CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

// ------------------------------------------------------------
// ORDERS
// ------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String?     // null for guest order
  guestEmail      String?
  guestPhone      String?
  shippingAddressId String?
  status          OrderStatus @default(PENDING_PAYMENT)

  subtotal        Decimal @db.Decimal(10, 2)
  discountTotal   Decimal @db.Decimal(10, 2) @default(0)
  taxTotal        Decimal @db.Decimal(10, 2) @default(0)
  shippingTotal   Decimal @db.Decimal(10, 2) @default(0)
  grandTotal      Decimal @db.Decimal(10, 2)

  couponCode      String?
  idempotencyKey  String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer        CustomerProfile? @relation(fields: [customerId], references: [id])
  shippingAddress Address?         @relation(fields: [shippingAddressId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  shipment        Shipment?
  returnRequests  ReturnRequest[]
  statusHistory   OrderStatusHistory[]

  @@index([customerId])
  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String? // admin user id, null if system
  reason    String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

// Immutable snapshot at time of purchase — historical orders must never
// depend on mutable current product data.
model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  variantId       String
  productNameSnap String
  variantNameSnap String
  skuSnap         String
  imageUrlSnap    String?
  unitPriceSnap   Decimal @db.Decimal(10, 2)
  quantity        Int
  discountApplied Decimal @db.Decimal(10, 2) @default(0)
  taxApplied      Decimal @db.Decimal(10, 2) @default(0)

  order           Order            @relation(fields: [orderId], references: [id])
  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  serializedUnits SerializedUnit[]
  returnItems     ReturnItem[]
}

// ------------------------------------------------------------
// SHIPPING / COURIER
// Flagged as a missing "payment-shaped hole" in review — mirrors the
// PaymentProvider adapter pattern for courier integration.
// ------------------------------------------------------------

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED_TO_ORIGIN
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  courierName    String? // e.g. "TCS", "Leopards", "PostEx", "M&P"
  waybillNumber  String?        @unique
  trackingUrl    String?
  status         ShipmentStatus @default(PENDING)
  isCod          Boolean        @default(false)
  codAmount      Decimal?       @db.Decimal(10, 2)
  codRemittedAt  DateTime? // when courier remitted cash to merchant — RTO/
                              // reconciliation gap flagged in review
  codRemittedAmount Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order          Order                @relation(fields: [orderId], references: [id])
  statusEvents   ShipmentStatusEvent[]
}

model ShipmentStatusEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  rawPayload Json? // raw courier webhook payload for audit/debug
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])
}

// ------------------------------------------------------------
// PAYMENTS
// ------------------------------------------------------------

enum PaymentMethod {
  CARD
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  providerName   String? // e.g. gateway name, null for COD
  providerRef    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order        Order               @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]
  refunds      Refund[]
}

// A payment can have multiple attempts/transactions (retry after decline).
model PaymentTransaction {
  id             String   @id @default(cuid())
  paymentId      String
  providerTxnId  String?  @unique
  status         PaymentStatus
  rawResponse    Json?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

model Refund {
  id            String   @id @default(cuid())
  paymentId     String
  amount        Decimal  @db.Decimal(10, 2)
  reason        String?
  providerRef   String?
  processedById String? // admin actor
  createdAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// ------------------------------------------------------------
// COUPONS
// ------------------------------------------------------------

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  DISABLED
}

model Coupon {
  id                  String       @id @default(cuid())
  code                String       @unique // normalized uppercase
  type                CouponType
  amount              Decimal      @db.Decimal(10, 2)
  minimumOrderValue   Decimal?     @db.Decimal(10, 2)
  maximumDiscount     Decimal?     @db.Decimal(10, 2)
  startAt             DateTime?
  expiresAt           DateTime?
  usageLimit          Int?
  perCustomerLimit    Int?
  status              CouponStatus @default(DRAFT)
  createdAt           DateTime     @default(now())

  eligibility CouponEligibility[]
  redemptions CouponRedemption[]
}

model CouponEligibility {
  id         String  @id @default(cuid())
  couponId   String
  productId  String?
  categoryId String?

  coupon Coupon @relation(fields: [couponId], references: [id])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  customerId String?
  orderId    String
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([couponId, orderId])
}

// ------------------------------------------------------------
// RETURNS
// ------------------------------------------------------------

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  INSPECTED
  REFUND_ISSUED
  EXCHANGE_ISSUED
  COMPLETED
}

model ReturnRequest {
  id            String       @id @default(cuid())
  orderId       String
  customerId    String?
  reason        String
  status        ReturnStatus @default(REQUESTED)
  adminNotes    String?
  // Inspection checkpoint — flagged as missing in review: approval and
  // refund must not be a single step for high-value items (anti-swap
  // fraud). Inspection is a required gate before refund/exchange.
  inspectionPassed   Boolean?
  inspectionNotes    String?
  inspectedById      String?
  refundAmount  Decimal?     @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  customer CustomerProfile? @relation(fields: [customerId], references: [id])
  items    ReturnItem[]
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  // For serialized items, capture the serial being returned so it can be
  // matched against the original sold serial (anti-swap fraud).
  returnedSerialNumber String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
}

// ------------------------------------------------------------
// WISHLIST / REVIEWS
// ------------------------------------------------------------

model Wishlist {
  id         String @id @default(cuid())
  customerId String @unique
  shareToken String? @unique // non-guessable, only if sharing enabled

  customer CustomerProfile @relation(fields: [customerId], references: [id])
  items    WishlistItem[]
}

model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  addedAt    DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([wishlistId, productId, variantId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  customerId         String
  orderItemId        String? // presence + valid order = verified purchase;
                                // never a client-supplied flag
  rating             Int
  title              String?
  body               String?
  status             ReviewStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  moderatedById       String?

  product  Product          @relation(fields: [productId], references: [id])
  customer CustomerProfile  @relation(fields: [customerId], references: [id])
  images   ReviewImage[]

  @@index([productId])
}

model ReviewImage {
  id           String @id @default(cuid())
  reviewId     String
  mediaAssetId String

  review     Review     @relation(fields: [reviewId], references: [id])
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])
}

model BackInStockSubscription {
  id        String   @id @default(cuid())
  variantId String
  email     String
  notifiedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([variantId, email])
}

// ------------------------------------------------------------
// CMS / CONTENT
// ------------------------------------------------------------

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Homepage {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  sections ContentSection[]
}

// Fixed section types only in MVP — no arbitrary block builder.
enum SectionType {
  HERO
  PROMOTIONAL_BANNER
  FEATURED_CATEGORY
  PRODUCT_CAROUSEL
  TEXT_BLOCK
  NEWSLETTER_SIGNUP
}

model ContentSection {
  id          String        @id @default(cuid())
  homepageId  String
  type        SectionType
  sortOrder   Int
  isVisible   Boolean       @default(true)
  status      ContentStatus @default(DRAFT)
  scheduledAt DateTime?
  content     Json // shape depends on `type`, validated at app layer
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  homepage Homepage @relation(fields: [homepageId], references: [id])
}

model Banner {
  id            String        @id @default(cuid())
  title         String
  subtitle      String?
  ctaLabel      String?
  ctaUrl        String?
  mediaAssetId  String?
  status        ContentStatus @default(DRAFT)
  startAt       DateTime?
  endAt         DateTime?
  createdAt     DateTime      @default(now())

  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id])
}

model Navigation {
  id   String @id @default(cuid())
  name String // e.g. "header", "footer"

  items NavigationItem[]
}

model NavigationItem {
  id           String  @id @default(cuid())
  navigationId String
  label        String
  url          String
  sortOrder    Int     @default(0)
  parentId     String?

  navigation Navigation       @relation(fields: [navigationId], references: [id])
  parent     NavigationItem?  @relation("NavTree", fields: [parentId], references: [id])
  children   NavigationItem[] @relation("NavTree")
}

model ContentPage {
  id       String        @id @default(cuid())
  slug     String        @unique
  title    String
  body     String // sanitized rich text, allowlist editor only
  status   ContentStatus @default(DRAFT)
  seoTitle String?
  seoDescription String?
  updatedAt DateTime     @updatedAt
}

// Automatic redirect on slug change — required, not optional.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  productId String?
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id])
}

// ------------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

model Notification {
  id          String              @id @default(cuid())
  recipient   String
  channel     NotificationChannel
  type        String // e.g. "order_confirmed", "shipment_update"
  status      String  @default("PENDING") // PENDING, SENT, FAILED
  providerRef String?
  createdAt   DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String // SENT, FAILED
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// SITE SETTINGS
// ------------------------------------------------------------

// Key-value settings store rather than one column per setting — avoids
// a schema migration every time a new configurable value is needed.
// Values are stored as strings/JSON and parsed at the application
// layer (src/domain/settings/service.ts) with sane defaults when a key
// is absent, so missing settings never crash a read.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?
}

// ------------------------------------------------------------
// AUDIT
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "product.price_changed"
  resource   String // e.g. "Product:cku123"
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([resource])
  @@index([actorId])
}
